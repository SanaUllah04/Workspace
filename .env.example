# App
NEXT_PUBLIC_API_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Gemini (server-side only; do not prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Pinecone (server-side only; do not prefix with NEXT_PUBLIC_)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=quickstart
PINECONE_INDEX_HOST=https://your-index-host.pinecone.io
PINECONE_NAMESPACE=__default__
# This index uses Pinecone integrated inference; the model/dimension stay in Pinecone.

# Monitoring (optional)
SENTRY_DSN=
